<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Allergy Radar</string>
    <string name="widget_estimate">stima</string>
    <string name="widget_empty">Apri l\'app</string>
    <string name="widget_description">Livello dei pollini di oggi per i tuoi allergeni</string>

    <color name="widget_surface">#FFFFFFFF</color>
    <color name="widget_ink">#FF17201C</color>
    <color name="widget_muted">#FF5C6661</color>
    <color name="widget_track">#FFE4E1D7</color>

    <style name="WidgetRowName">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="WidgetRowLevel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="WidgetSegment">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:scaleType">fitXY</item>
        <item name="android:src">@drawable/widget_segment</item>
    </style>
</resources>
